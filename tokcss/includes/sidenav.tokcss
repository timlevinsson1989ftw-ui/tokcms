aside {
  inline-size:20rem;
  padding-block-end:3em;
  overflow:clip;
  ul {
    li {
      position: relative;
      & + & {
        border-block-start:1px solid hsl(231 7% 19%);
      }
      a {
        display: block;
        padding: 1em;
        color: inherit;
        text-decoration:none;
        transition:padding .5s, background .5s;
        &::before {
          position: absolute;
          content:"";
          inset-block:0;
          inset-inline-start:0;
          inline-size:4px;
          background: hsl(200 100% 50%);
          opacity:0;
          transition:opacity .5s;
        }
        &:hover {
          padding-inline-start:2em;
          background-color: hsl(200 100% 50% / .05);
          &::before {
            opacity:1;
          }
        }
      }
    }
  }
}