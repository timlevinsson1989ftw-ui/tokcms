main {
  flex:1;
  padding: 1em;
  display: grid;
  grid-template-columns:repeat(3, 1fr);
  gap:1em;
  .slider {
    border:1px solid hsl(226 12% 21%);
    border-radius: .3rem;
    padding: 1em;
    display: grid;
    grid-template-columns:1fr auto;
    gap:1em;
    grid-column:1/-1;
    background: 
      radial-gradient(circle at 100% 0, hsl(225 20% 30% / .25), #0000),
      linear-gradient(
        90deg, 
        hsl(225 15% 11%), 
        hsl(228 16% 12%),
        hsl(225 18% 9%)
      );
    .frame {
      .frame-content {
        .announcement-tag {
          border:1px solid hsl(194 100% 50% / .3);
          inline-size:fit-content;
          display: flex;
          padding-inline:.5em;
          padding-block:.3em;
          border-radius: calc(infinity * 1px);
          gap:.5em;
          background: hsl(194 100% 50% / .15);
          color: hsl(194 100% 50%);
          font-weight: 500;
          font-size: 0.8rem;
          margin-block-end:1em;
          &::before {
            content:"\25CF";
            text-box:trim-both cap alphabetic;
          }
        }
        h1 {
          font-weight: bold;
          font-size: 1.5rem;
          font-family: Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;
        }
        p {
          color: hsl(218 11% 65%);
        }
        .button-group {
          display: flex;
          gap:1em;
          button {
            padding-inline: 1em;
            padding-block:.7em;
            border-radius: .5rem;
            border:1px solid hsl(0 0% 25%);
            &:nth-child(1) {
              background: hsl(200 100% 50%);
              border-color:#0000;
              font-weight: 600;
              color: hsl(0 0% 0%);
              font-size: .8rem;
            }
            &:nth-child(2) {
              background: hsl(224 13% 17%);
            }
          }
        }
      }
    }
    .frame-controls {
      display: grid;
      align-content:center;
      grid-template-columns:repeat(2, 1fr);
      gap:.5em;
      .bars {
        grid-column:1/-1;
        display: flex;
        gap:.2em;
        .bar {
          block-size:.2em;
          background: hsl(200 80% 60%);
          inline-size:.1em;
          flex:1;
          border-radius: calc(infinity * 1px);
          &.active {
            flex:2;
          }
        }
      }
    }
  }
  .articles {
    border:1px solid white;
    grid-column:span 2;
    border:1px solid hsl(226 12% 21%);
    border-radius: .5rem;
    .content-title {
      display: flex;
      justify-content:space-between;
      padding: 1em;
    }
  }
  .quick-actions {
    border:1px solid hsl(226 12% 21%);
    padding: 1em;
    border-radius: .5rem;
    .actions {
      display: grid;
      grid-template-columns:repeat(2, 1fr);
      gap:1em;
      margin-block-start:1em;
      a {
        padding: 1em;
        border:1px solid hsl(226 12% 21%);
        text-decoration:none;
        color: hsl(0 0% 100%);
      }
    }
  }
}