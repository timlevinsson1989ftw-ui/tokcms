main {
  flex:1;
  padding: 1em;
  display: grid;
  grid-template-columns:repeat(3, 1fr);
  gap:1em;
  background: hsl(228 8% 13%);
  border-radius: .7rem;
  .slider {
    border:1px solid hsl(226 12% 21%);
    border-radius: .3rem;
    padding: 1em;
    display: grid;
    grid-template-columns:1fr auto;
    gap:1em;
    grid-column:1/-1;
    container-type:inline-size;
    background: 
      radial-gradient(circle at 100% 0, hsl(225 20% 30% / .25), #0000),
      linear-gradient(
        90deg, 
        hsl(225 15% 11%), 
        hsl(228 16% 12%),
        hsl(225 18% 9%)
      );
    .frame {
      .frame-content {
        .announcement-tag {
          border:1px solid hsl(194 100% 50% / .3);
          inline-size:fit-content;
          display: flex;
          padding-inline:.5em;
          padding-block:.3em;
          border-radius: calc(infinity * 1px);
          gap:.5em;
          background: hsl(194 100% 50% / .15);
          color: hsl(194 100% 50%);
          font-weight: 500;
          font-size: 0.8rem;
          margin-block-end:1em;
          &::before {
            content:"\25CF";
            text-box:trim-both cap alphabetic;
          }
        }
        h1 {
          font-weight: bold;
          font-size: 1.5rem;
          font-family: Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;
        }
        p {
          color: hsl(218 11% 65%);
        }
        .button-group {
          display: flex;
          gap:1em;
          button {
            padding-inline: 1em;
            padding-block:.7em;
            border-radius: .5rem;
            border:1px solid hsl(0 0% 25%);
            &:nth-child(1) {
              background: hsl(200 100% 50%);
              border-color:#0000;
              font-weight: 600;
              color: hsl(0 0% 0%);
              font-size: .8rem;
            }
            &:nth-child(2) {
              background: hsl(224 13% 17%);
            }
          }
        }
      }
    }
    .frame-controls {
      display: grid;
      align-content:center;
      grid-template-columns:repeat(2, 1fr);
      gap:.5em;
      .bars {
        grid-column:1/-1;
        display: flex;
        gap:.2em;
        .bar {
          block-size:.2em;
          background: hsl(200 80% 60%);
          inline-size:.1em;
          flex:1;
          border-radius: calc(infinity * 1px);
          &.active {
            flex:2;
          }
        }
      }
    }
  }
  .articles {
    border:1px solid white;
    grid-column:span 2;
    border:1px solid hsl(226 12% 21%);
    border-radius: .5rem;
    background: hsl(228 8% 10%);
    .content-title {
      display: flex;
      justify-content:space-between;
      padding: 1em;
      span {
        font-weight: bold;
        text-transform:uppercase;
      }
    }
    .article-content {
      display: grid;
      grid-template-columns:auto 1fr auto auto;
      column-gap:.5em;
      .article-row {
        grid-column:1/-1;
        display: grid;
        grid-template-columns:subgrid;
        padding: .5em;
        & + & {
          border-block-start:1px solid hsl(0 0% 20%);
        }
        .title-info {
          display: grid;
          gap:.3em;
        }
        .title {
          font-weight: bold;
        }
        .article-info {
          font-size: .85rem;
          color: hsl(0 0% 50%);
          a {
            color: hsl(0 0% 60%);
            font-weight: 500;
            text-decoration:none;
          }
          .username {
            --_role:attr(data-role type(<custom-ident>));
            color: if(
              style(--_role:Admin): red;
              style(--_role:Moderator): lime;
              else: white
            );
            font-weight: bold;
          }
        }
        .profile {
          border-radius: 50%;
        }
        .badge {
          --_status:attr(data-status type(<custom-ident>));
          color: if(
            style(--_status:Upcoming): oklch(.7 .3 200);
            style(--_status:Active): oklch(.7 .3 300);
            style(--_status:Draft): oklch(.7 .3 100);
            else:white
          );
          padding: .5em;
          border:2px solid;
          border-radius: .5rem;
          justify-self:end;
          align-self:center;
          background: hsl(from currentColor h s l / .15);
        }
        .edit {
          background: none;
          border:none;
          padding-inline:1em;
          color: hsl(0 0% 50%);
        }
      }
    }
  }
  .quick-actions {
    border:1px solid hsl(226 12% 21%);
    padding: 1em;
    border-radius: .5rem;
    background: hsl(228 8% 10%);
    .content-title {
      font-weight: bold;
      text-transform:uppercase;
    }
    .actions {
      display: grid;
      grid-template-columns:repeat(2, 1fr);
      gap:1em;
      margin-block-start:1em;
      a {
        padding: 1em;
        border:1px solid hsl(226 12% 21%);
        text-decoration:none;
        color: hsl(0 0% 100%);
        white-space:nowrap;
      }
    }
  }
  .pulse {
    background: hsl(228 8% 10%);
    border-radius: .5rem;
    border:1px solid hsl(221 12% 21%);
    padding: 1em;
    gap:.5em;
    container-type:inline-size;
    display: grid;
    gap:1em;
    .top-row {
      display: flex;
      justify-content:space-between;
      align-content:center;
      .title {
        font-weight: bold;
      }
      .right {
        color: hsl(0 0% 50%);
        font-size: .8rem;
      }
    }
    .pulse-container {
      display: grid;
      gap:.5em;
      @container (width >= 20rem) {
        grid-template-columns:1fr 1fr;
      }
      .box {
        background: hsl(225 11% 16%);
        border:1px solid hsl(225 11% 26%);
        border-radius: .5rem;
        padding: .5em;
        .box-title {
          color: hsl(228 10% 70%);
        }
        .box-amount {
          font-size: 1.5rem;
          font-weight: 900;
        }
        .percentage {
          font-weight: bold;
        }
        &:nth-child(1) .percentage {
          color: hsl(148 65% 51%);
        }
        &:nth-child(2) .percentage {
          color: hsl(284 54% 67%);
        }
      }
    }
    .graph {
      color: hsl(0 0% 60%);
      .graph-header {
        display: flex;
        justify-content:space-between;
      }
      .bars {
        display: flex;
        gap:.2em;
        block-size:5rem;
        align-items:end;
        .bar {
          --from: .3;
          --to: 1;
          background: hsl(195 100% 50% / calc(var(--from) + (var(--to) - var(--from)) * (sibling-index() - 1) / (sibling-count() - 1)));
          flex:1;
          block-size:calc(6rem / (sibling-count() + 1) * (sibling-index() - .5));
          border-radius: .3rem;
        }
      }
    }
  }
}