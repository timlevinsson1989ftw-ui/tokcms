@layer reset, base, layout, components;

@layer reset {
  * { box-sizing: border-box; }
}

:root {
  --bg: oklch(.32 0 0);
  --topbar: oklch(.2 0 0);
  --sidebar: oklch(.22 0 0);
  --sidebar-hover: oklch(.28 0 0);
  --panel: oklch(.94 0 0);
  --panel-head: oklch(.86 0 0);
  --text: oklch(.25 0 0);
  --text-light: oklch(.85 0 0);
  --accent: oklch(.55 .13 240);
  --danger: oklch(.6 .2 25);
  --max: 64rem;
}

@layer base {
  body {
    margin: 0;
    min-block-size: 100svb;
    background: var(--bg);
    color: var(--text);
    font: 1rem/1.5 system-ui, sans-serif;
  }
  a { color: var(--accent); }
}

@layer layout {
  .topbar {
    background: var(--topbar);
    color: var(--text-light);

    & .inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-inline-size: var(--max);
      margin-inline: auto;
      padding: .75rem 1rem;
    }
    & .logo {
      color: white;
      font-size: 1.5rem;
      font-weight: 700;
      font-style: italic;
      text-decoration: none;
    }
    & .actions {
      display: flex;
      align-items: center;
      gap: .5rem;

      & form { margin: 0; }
    }
  }

  .shell {
    display: grid;
    grid-template-columns: 15rem 1fr;
    max-inline-size: var(--max);
    margin: 2rem auto;
    background: var(--panel);
    overflow: clip;
    box-shadow: 0 0 3rem oklch(0 0 0 / .4);
  }

  .sidebar {
    background: var(--sidebar);
    color: var(--text-light);
    min-block-size: 30rem;

    & h2 {
      margin: 0;
      padding: .75rem 1rem;
      font-size: 1rem;
      background: var(--sidebar-hover);
    }
    & a {
      display: block;
      padding: .6rem 1.25rem;
      color: var(--text-light);
      text-decoration: none;

      &:hover, &.is-active { background: var(--sidebar-hover); color: white; }
    }
  }

  .content {
    min-inline-size: 0;
    padding: 1rem;
  }
}

@layer components {
  .panel {
    background: white;
    border: 1px solid oklch(.8 0 0);
  }
  .panel-head {
    margin: 0;
    padding: .6rem 1rem;
    font-size: 1.25rem;
    text-align: center;
    background: linear-gradient(oklch(.95 0 0), var(--panel-head));
  }
  .panel-body { padding: 1rem; }

  .btn {
    padding: .35rem .75rem;
    color: inherit;
    font: inherit;
    font-size: .875rem;
    text-decoration: none;
    background: oklch(1 0 0 / .08);
    border: 1px solid oklch(1 0 0 / .25);
    border-radius: .25rem;
    cursor: pointer;

    &.primary { background: var(--accent); border-color: transparent; color: white; }
  }

  .login {
    display: grid;
    place-items: center;
    min-block-size: 100svb;
    padding: 1rem;
  }
  .login-card {
    inline-size: stretch;
    max-inline-size: 24rem;
    display: grid;
    gap: 1rem;
    padding: 2rem;
    background: var(--panel);

    & h1 { margin: 0; font-size: 1.5rem; text-align: center; }
    & label { display: grid; gap: .25rem; font-size: .875rem; }
    & input { padding: .5rem; font: inherit; }
    & .error { margin: 0; color: var(--danger); }
  }
}