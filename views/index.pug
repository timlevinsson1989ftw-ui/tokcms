extends layout
block content
  -
    const articles = [
      {profile:"//i.pravatar.cc/40?img=3", title:"Account Registrations", link:{text:"Website Updates", link:"/news"}, postdate:"2h", badge:"Upcoming", author:"Tok124", role:"Admin"},
      {profile:"//i.pravatar.cc/40?img=3", title:"Logins", link:{text:"Website Updates", link:"/news"}, postdate:"2h", badge:"Upcoming", author:"Tok124", role:"Admin"},
    ]
  .slider
    .frame
      .frame-content
        .announcement-tag RELEASE ANNOUNCEMENT
        h1 TokCMS v1.0 is Live: New Block Editor & Survey Builder 
        p Discover faster publishing workflows, live CSS preview, dynamic schema forms, and real-time team collaboration tools tailored for high-output engineering hubs.
        .button-group 
          button Explore Features
          button Read Release Notes
    .frame-controls 
      button.previous-frame &lt;
      button.next-frame &gt;
      .bars
        .bar.active
        .bar 
        .bar
  .articles 
    .content-title
      span RECENT & UPCOMING UPDATES
      a(href="#") View All &gt;
    .article-content
      each row in articles
        .article-row
          img.profile(src=row.profile)
          .title-info
            .title #{row.title}
            .article-info in #[a(href=row.link.link) #{row.link.text}] &bull; #[span.postdate #{row.postdate} ago by #[a.username(href=`/profile/${row.author}` data-role=row.role) @#{row.author}]]
          .badge(data-status=row.badge) #{row.badge}
          button.edit
            i.fa-solid.fa-pen-to-square
  .quick-actions 
    .content-title Quick Actions
    .actions 
      a(href="#") New Article 
      a(href="#") Create Survey 
      a(href="#") Upload Asset 
      a(href="#") CSS Settings
  .pulse
    .top-row
      .title WEEKLY PULSE 
      .right Last 7 days
    .pulse-container
      .box
        .box-title Weekly Readers
        .box-amount 74.8k
        .percentage +14.2%
      .box
        .box-title Weekly Submissions
        .box-amount 1,420
        .percentage +8.1%
    .graph
      .graph-header
        .flow-title Traffic Flow
        .uptime 98.6% System Uptime
      .bars
        each day in Array(7)
          .bar
          